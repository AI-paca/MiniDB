        <mxCell id="rs" value="OUT_DIR/tables.rs&#10;struct Experiment + Default&#10;VERSION / LAYOUT / COLUMNS&#10;from_row / to_values / insert / update" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#537eac;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1110" y="200" width="530" height="140" as="geometry" />
        </mxCell>
        <mxCell id="custom" value="experiments_rules.rs&#10;impl Experiment { validate, score }&#10;Ручной файл: генератор его не меняет" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff9e9;strokeColor=#bd9a45;strokeWidth=1.5;" vertex="1" parent="1">
