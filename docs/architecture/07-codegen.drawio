        <mxCell id="cli" value="CLI → Database → Row::at&#10;Динамически по текущей Schema&#10;Новый столбец доступен сразу после ALTER" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;" vertex="1" parent="1">
