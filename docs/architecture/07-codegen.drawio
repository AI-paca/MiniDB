        </mxCell>
        <mxCell id="sim" value="Симулятор → Database → from_row&#10;Value → i64 / String / Option&lt;T&gt;&#10;Проверка совместимости колонок" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;" vertex="1" parent="1">
