<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="06-keys.drawio" name="6. PK и FK: добавление связи, изменение строк и ограничения DDL">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1250" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="6. PK и FK: добавление связи, изменение строк и ограничения DDL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f3f5f8;strokeColor=#8090a2;strokeWidth=1.5;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Database проверяет связи по актуальной Schema каждого запроса. Отдельного индекса дочерних FK и кэша графа связей нет." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f3f5f8;strokeColor=#8090a2;strokeWidth=1.5;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="1640" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ddl" value="НОВАЯ СВЯЗЬ ВО ВРЕМЯ РАБОТЫ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f6f1fa;strokeColor=#9170af;strokeWidth=1.5;verticalAlign=top;fontStyle=1;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="130" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="sql" value="ALTER TABLE experiments ADD COLUMN reviewer_id INT NULL REFERENCES models(id);" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f6f1fa;strokeColor=#9170af;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="720" height="80" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="Database::add_column → check_schema&#10;Целевая таблица уже есть; цель — её INT PRIMARY KEY.&#10;Новая колонка nullable, старые строки получат NULL.&#10;NULL не требует родителя; нет проверки произвольного старого значения." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f6f1fa;strokeColor=#9170af;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="315" width="720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="publish" value="ПЕРЕКЛЮЧЕНИЕ И ДОСТУПНОСТЬ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;verticalAlign=top;fontStyle=1;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="130" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="rewrite" value="Table::rewrite → сохранить схему → заменить Table.schema&#10;Новый REFERENCES действует в том же процессе сразу.&#10;Перезапуск / перегенерация Rust для CLI не нужны." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="920" y="190" width="720" height="120" as="geometry" />
        </mxCell>
        <mxCell id="live" value="Следующий INSERT / UPDATE&#10;reviewer_id = 1 → lookup models.index[1]&#10;Есть родитель → разрешить; нет → отклонить весь план.&#10;reviewer_id = NULL → разрешить." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="920" y="360" width="720" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pk" value="PRIMARY KEY · Table.index" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#537eac;strokeWidth=1.5;verticalAlign=top;fontStyle=1;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="590" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="pkops" value="INSERT: auto-ID или явный PK; дубль запрещён.&#10;Успех → index[id] = offset.&#10;UPDATE PK: план проверяет новые дубли;&#10;применение убирает старый ключ и ставит новый.&#10;DELETE: убрать из index, слот пометить DEAD.&#10;ALTER/VACUUM/open: индекс построить заново." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#537eac;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="child" value="ИЗМЕНЕНИЕ ДОЧЕРНЕЙ СТРОКИ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;verticalAlign=top;fontStyle=1;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="590" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="childops" value="Database::check_foreign_keys&#10;Для каждой REFERENCES: NULL пропустить;&#10;INT → PK lookup в родительской таблице.&#10;UPDATE сначала проверяет весь пакет.&#10;Для self-FK учитываются итоговые ключи&#10;пакета, а не только старое состояние." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="620" y="660" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="parent" value="DELETE / UPDATE PK РОДИТЕЛЯ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff9e9;strokeColor=#bd9a45;strokeWidth=1.5;verticalAlign=top;fontStyle=1;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="590" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="restrict" value="Database::check_references&#10;Найти ссылки в текущих схемах всех таблиц.&#10;Просмотреть LIVE дочерних таблиц.&#10;Есть действующая ссылка → RESTRICT.&#10;Нет → разрешить. Каскадного изменения нет.&#10;Проверка стоит O(дочерних слотов)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff9e9;strokeColor=#bd9a45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1180" y="660" width="460" height="200" as="geometry" />
        </mxCell>
        <mxCell id="unsupported" value="УДАЛИТЬ КОЛОНКУ / СНЯТЬ FK-ФЛАГ&#10;DROP COLUMN и DROP CONSTRAINT не реализованы;&#10;check_evolution запрещает менять старые поля и REFERENCES.&#10;Такой DDL отклоняется до записи. Автоматического CASCADE нет." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff2f0;strokeColor=#c58179;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="30" y="960" width="780" height="180" as="geometry" />
        </mxCell>
        <mxCell id="external" value="ОБНОВЛЕНИЕ «В РЕАЛЬНОМ ВРЕМЕНИ»&#10;Через Database API: сразу после успешной команды.&#10;Через внешний редактор: watcher отсутствует; закрыть и открыть БД.&#10;open проверяет структуру и PK; сохранённые FK не сканируются.&#10;Ручная правка файлов не заменяет поддерживаемую миграцию." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f3f5f8;strokeColor=#8090a2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="890" y="960" width="780" height="180" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontSize=14;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#8090a2;strokeWidth=1.7;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sql" target="validate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="корректная новая схема" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontSize=14;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#8090a2;strokeWidth=1.7;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="validate" target="rewrite">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="395" />
              <mxPoint x="850" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontSize=14;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#8090a2;strokeWidth=1.7;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rewrite" target="live">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>