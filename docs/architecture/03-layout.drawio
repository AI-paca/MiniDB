  <diagram id="03-layout.drawio" name="3. Schema → Layout; текст ↔ запись; запись → Value">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1120" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="3. Schema → Layout; текст ↔ запись; запись → Value" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f3f5f8;strokeColor=#8090a2;strokeWidth=1.5;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Layout — вычисленное описание байтов в RAM. TextFile — кодек/сериализатор. Генератор Rust показан отдельно на листе 7." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f3f5f8;strokeColor=#8090a2;strokeWidth=1.5;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="1540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="schema" value="Schema: 3 колонки&#10;id INT PRIMARY KEY&#10;name STRING(8) NOT NULL&#10;score FLOAT NULL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f6f1fa;strokeColor=#9170af;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="30" y="140" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="calc" value="Layout::from_schema&#10;null_bytes = ceil(3 / 8) = 1&#10;header = flag(1) + null_bytes = 2&#10;INT/FLOAT: 8; STRING(n): 2 + n" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f6f1fa;strokeColor=#9170af;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="540" y="140" width="510" height="180" as="geometry" />
        </mxCell>
        <mxCell id="offsets" value="Layout.cols&#10;id: offset 2, width 8&#10;name: offset 10, width 10&#10;score: offset 20, width 8&#10;row_size = 28 байт" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f6f1fa;strokeColor=#9170af;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1140" y="140" width="430" height="180" as="geometry" />
        </mxCell>
        <mxCell id="disk" value="ДИСК · текст переменной длины&#10;LIVE\t1\t&quot;iris&quot;\tNULL&#10;LIVE\t2\t&quot;mnist&quot;\t0.91&#10;Здесь \t обозначает настоящий Tab.&#10;Одна строка данных — слот; длина текста меняется." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff2f0;strokeColor=#c58179;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="30" y="410" width="590" height="190" as="geometry" />
        </mxCell>
        <mxCell id="codec" value="TextFile::reload / persist&#10;Разбор литералов по Schema&#10;record::encode / Row::at&#10;Сохранение: текстовый снимок&#10;В файле нет бинарных offsets" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="730" y="410" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="address" value="Table.index&#10;PK 1 → RAM offset 0&#10;PK 2 → RAM offset 28&#10;Это адрес слота в памяти,&#10;не позиция в UTF-8 файле." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff9e9;strokeColor=#bd9a45;strokeWidth=1.5;" vertex="1" parent="1">
