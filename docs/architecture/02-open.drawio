<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="02-open.drawio" name="2. Открытие базы: из файлов в рабочие структуры">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1050" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="2. Открытие базы: из файлов в рабочие структуры" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f3f5f8;strokeColor=#8090a2;strokeWidth=1.5;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Индекс не хранится рядом с данными. Он восстанавливается при каждом открытии." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f3f5f8;strokeColor=#8090a2;strokeWidth=1.5;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="1540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="disk" value="ИСТОЧНИК НА ДИСКЕ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff2f0;strokeColor=#c58179;strokeWidth=1.5;verticalAlign=top;fontStyle=1;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="130" width="460" height="740" as="geometry" />
        </mxCell>
        <mxCell id="lock" value="Database::open(path)&#10;Создать / открыть каталог&#10;Взять эксклюзивную .lock" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff2f0;strokeColor=#c58179;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="schema" value="storage::schema_files&#10;Найти только *_schema&#10;Schema::from_text → check&#10;Прочитать GENERATION = 7" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff2f0;strokeColor=#c58179;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="file" value="Открыть datasets_7&#10;Заголовок должен совпасть&#10;Нет файла / повреждение → ошибка&#10;Другие поколения пока сохранить" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff2f0;strokeColor=#c58179;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ram" value="СБОРКА TABLE В ПАМЯТИ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;verticalAlign=top;fontStyle=1;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="130" width="500" height="740" as="geometry" />
        </mxCell>
        <mxCell id="layout" value="Layout::from_schema&#10;Проверить структуру один раз&#10;Посчитать row_size и offsets" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f6f1fa;strokeColor=#9170af;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="570" y="200" width="440" height="115" as="geometry" />
        </mxCell>
        <mxCell id="decode" value="TextFile::reload&#10;Разобрать UTF-8 и литералы&#10;LIVE / DEAD / FREE → fixed slots&#10;Cursor&lt;Vec&lt;u8&gt;&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="570" y="390" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="index" value="rebuild_loaded_index&#10;LIVE: прочитать PK, запрет дублей&#10;index[id] = slot × row_size&#10;DEAD/FREE → free; восстановить max ID" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="570" y="620" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="finish" value="ПУБЛИКАЦИЯ И УБОРКА" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff9e9;strokeColor=#bd9a45;strokeWidth=1.5;verticalAlign=top;fontStyle=1;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="130" width="480" height="740" as="geometry" />
        </mxCell>
        <mxCell id="cleanup" value="Только после успешного чтения&#10;Удалить datasets_N, где N ≠ 7&#10;Удалить временные файлы движка&#10;Файлы редактора не трогать" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff9e9;strokeColor=#bd9a45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1120" y="200" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="checks" value="Все таблицы уже загружены&#10;Database::check_schema&#10;Цели FK существуют, цель — PK&#10;Rust-валидаторы зарегистрированы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#fff9e9;strokeColor=#bd9a45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1120" y="430" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="База готова к командам&#10;Каталог имя → Table в RAM&#10;Индексы и ограничения доступны&#10;Нет наблюдателя за файлами" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f0f8f3;strokeColor=#5d9073;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1120" y="660" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Цена открытия: полный разбор текста и O(числа слотов) на индекс. Память: все данные + HashMap + free.&#10;При открытии проверяются структура и PK; RESTORE проверяет поля через Table::check. Сохранённые FK при open не сканируются." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#233347;spacing=12;align=left;verticalAlign=middle;fillColor=#f3f5f8;strokeColor=#8090a2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="30" y="910" width="1540" height="100" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontSize=14;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#8090a2;strokeWidth=1.7;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lock" target="schema">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontSize=14;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#8090a2;strokeWidth=1.7;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="schema" target="file">
          <mxGeometry relative="1" as="geometry" />
