<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="g2" name="02-Открытие">
<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
<root>
<mxCell id="0" /><mxCell id="1" parent="0" />

<mxCell id="t" value="Открытие базы" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="30" as="geometry" /></mxCell>

<mxCell id="s1" value="занять замок&lt;br&gt;найти файлы схем" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="230" height="70" as="geometry" /></mxCell>
<mxCell id="s2" value="прочитать схему таблицы&lt;br&gt;&lt;i&gt;колонки, ключ, ссылки,&lt;br&gt;номер версии, история&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="230" height="70" as="geometry" /></mxCell>
<mxCell id="s3" value="посчитать дескриптор&lt;br&gt;на каждую версию" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="80" width="230" height="70" as="geometry" /></mxCell>
<mxCell id="s4" value="открыть файлы версий&lt;br&gt;&lt;i&gt;последнюю на запись,&lt;br&gt;прежние на чтение&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="80" width="230" height="70" as="geometry" /></mxCell>

<mxCell id="s5" value="полный проход по всем слотам всех версий" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;startSize=34;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1040" height="170" as="geometry" /></mxCell>
<mxCell id="s5a" value="живой&lt;br&gt;→ ключ в указатель" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="s5"><mxGeometry x="30" y="55" width="300" height="60" as="geometry" /></mxCell>
<mxCell id="s5b" value="удалён&lt;br&gt;→ слот в свободные,&lt;br&gt;ключ учесть в счётчике" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="s5"><mxGeometry x="370" y="55" width="300" height="60" as="geometry" /></mxCell>
<mxCell id="s5c" value="два одинаковых ключа&lt;br&gt;→ отказ открывать" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;" vertex="1" parent="s5"><mxGeometry x="710" y="55" width="300" height="60" as="geometry" /></mxCell>

<mxCell id="s6" value="проверить ссылки между таблицами&lt;br&gt;&lt;i&gt;после загрузки всех схем, поэтому порядок открытия не важен&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="500" height="70" as="geometry" /></mxCell>
<mxCell id="s7" value="в памяти: схема · дескрипторы · указатель · свободные слоты · счётчик номеров" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="420" width="500" height="70" as="geometry" /></mxCell>

<mxCell id="n" value="Цена открытия — весь объём данных. Зато нет файла индекса, который мог бы разойтись с данными." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1040" height="55" as="geometry" /></mxCell>

<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6366f1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>

</root>
