<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="t5" name="05-Порядок строк">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
<root>
<mxCell id="0" /><mxCell id="1" parent="0" />

<mxCell id="t" value="В каком порядке выходят строки" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry" /></mxCell>

<mxCell id="r" value="Правило" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="620" height="200" as="geometry" /></mxCell>
<mxCell id="r1" value="версии по возрастанию номера,&lt;br&gt;внутри версии — слоты по возрастанию адреса&lt;br&gt;&lt;br&gt;никакой сортировки по ключу нет&lt;br&gt;команды упорядочивания тоже нет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="r"><mxGeometry x="20" y="45" width="580" height="100" as="geometry" /></mxCell>

<mxCell id="ex" value="Почему порядок кажется странным" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="660" height="200" as="geometry" /></mxCell>
<mxCell id="ex1" value="удалённый слот попадает в список свободных&lt;br&gt;следующая вставка занимает его&lt;br&gt;новая строка появляется в середине выдачи,&lt;br&gt;а не в конце" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="ex"><mxGeometry x="20" y="45" width="620" height="80" as="geometry" /></mxCell>
<mxCell id="ex2" value="после добавления колонки новые строки уходят&lt;br&gt;в следующую версию, то есть в конец общей выдачи" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="ex"><mxGeometry x="20" y="135" width="620" height="50" as="geometry" /></mxCell>

<mxCell id="d" value="Пример: ключи 1..5, затем удалили 3 и вставили 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="1320" height="240" as="geometry" /></mxCell>

<mxCell id="d1" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="d"><mxGeometry x="30" y="60" width="90" height="40" as="geometry" /></mxCell>
<mxCell id="d2" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="d"><mxGeometry x="130" y="60" width="90" height="40" as="geometry" /></mxCell>
<mxCell id="d3" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;" vertex="1" parent="d"><mxGeometry x="230" y="60" width="90" height="40" as="geometry" /></mxCell>
<mxCell id="d4" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="d"><mxGeometry x="330" y="60" width="90" height="40" as="geometry" /></mxCell>
<mxCell id="d5" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="d"><mxGeometry x="430" y="60" width="90" height="40" as="geometry" /></mxCell>
<mxCell id="dn" value="строка с ключом 6 заняла слот удалённой тройки&lt;br&gt;выдача пойдёт в порядке 1, 2, 6, 4, 5" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="d"><mxGeometry x="560" y="60" width="500" height="60" as="geometry" /></mxCell>
<mxCell id="dw" value="Следствие: на порядок нельзя опираться ни в сценариях проверки, ни в отчёте.&lt;br&gt;Если нужен стабильный вид — сортировать уже на выводе." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="d"><mxGeometry x="30" y="140" width="1260" height="60" as="geometry" /></mxCell>

</root>
</mxGraphModel>
</diagram>

</mxfile>