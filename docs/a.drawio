        <mxCell id="coordinator" value="&lt;b&gt;Database Coordinator&lt;/b&gt;&lt;br&gt;каталог таблиц&lt;br&gt;маршрутизация команд&lt;br&gt;порядок изменений" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="280" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="query" value="&lt;b&gt;Query Engine&lt;/b&gt;&lt;br&gt;проекция столбцов&lt;br&gt;WHERE: =, !=, &amp;gt;, &amp;lt;, &amp;gt;=, &amp;lt;=&lt;br&gt;AND / OR, INNER JOIN&lt;br&gt;результат выдаётся потоком" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1320" y="280" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="integrity" value="&lt;b&gt;Проверка целостности&lt;/b&gt;&lt;br&gt;PK: уникальность и авто-ID&lt;br&gt;FK: конкретная колонка-цель&lt;br&gt;RESTRICT: не удалить родителя с детьми&lt;br&gt;Межтабличные записи согласуются здесь" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="540" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="table_runtime" value="&lt;b&gt;TableRuntime × 3&lt;/b&gt;&lt;br&gt;datasets / models / experiments&lt;br&gt;сегменты каждой версии схемы&lt;br&gt;индекс PK → (segment, offset)&lt;br&gt;модули версий таблицы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="860" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="module_runtime" value="&lt;b&gt;Загруженный TableModule&lt;/b&gt;&lt;br&gt;Сгенерированная структура таблицы&lt;br&gt;Прямой доступ по готовым offset&lt;br&gt;Валидаторы и формулы на Rust&lt;br&gt;Без поиска descriptor на каждой строке" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1340" y="860" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="buffer" value="&lt;b&gt;Переиспользуемый буфер&lt;/b&gt;&lt;br&gt;читает текущую запись или блок&lt;br&gt;растёт и сохраняет capacity&lt;br&gt;всю таблицу в RAM не загружает" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="860" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="write_path" value="&lt;b&gt;Операции с записью&lt;/b&gt;&lt;br&gt;INSERT: проверить → записать → индекс&lt;br&gt;UPDATE: новая версия → обновить индекс&lt;br&gt;DELETE: FLAG_DEAD; позиции не сдвигаются" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1340" y="540" width="380" height="160" as="geometry" />
        </mxCell>
        <mxCell id="runtime_note" value="TableRuntime — объект внутри одного процесса MiniDB, не отдельный OS-процесс. Один координатор согласует изменения и предотвращает гонку между FK-проверкой и удалением родителя.&#10;Очередь или отдельный writer-поток на таблицу можно добавить позже." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacing=20;fontSize=15;fontColor=#475569;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="320" y="1790" width="2440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="module_builder" value="&lt;b&gt;TableModuleBuilder&lt;/b&gt;&lt;br&gt;читает определение таблицы&lt;br&gt;генерирует типизированную структуру&lt;br&gt;и функции прямого доступа" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2100" y="280" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="compiler" value="&lt;b&gt;rustc&lt;/b&gt;&lt;br&gt;собирает только модуль таблицы&lt;br&gt;основной MiniDB не пересобирается" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2100" y="560" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="module_artifact" value="&lt;b&gt;Нативный модуль версии V&lt;/b&gt;&lt;br&gt;одна таблица / одна версия схемы&lt;br&gt;хранится в db/modules/" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2100" y="820" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="catalog_file" value="&lt;b&gt;catalog.bin&lt;/b&gt;&lt;br&gt;логическое имя → физический table_id&lt;br&gt;каталог можно восстановить сканированием" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="1450" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="segments_file" value="&lt;b&gt;table_0001_v1.seg&lt;/b&gt;&lt;br&gt;[flag][null bitmap][поля по offset]&lt;br&gt;fixed width внутри версии&lt;br&gt;STRING задаёт max_bytes&lt;br&gt;ALTER → новый модуль и сегмент V2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="1450" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="index_file" value="&lt;b&gt;PK index&lt;/b&gt;&lt;br&gt;PK → (segment_id, offset)&lt;br&gt;восстанавливается из живых записей&lt;br&gt;Seq Scan / Index Scan для benchmark" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1290" y="1450" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="backup_file" value="&lt;b&gt;db_backups/first/ — копия схемы, модулей и сегментов&lt;/b&gt;&lt;br&gt;WAL / recovery — отдельное будущее расширение" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="1630" width="1370" height="85" as="geometry" />
        </mxCell>
        <mxCell id="table_source" value="&lt;b&gt;table_0001.rs — аналог .h&lt;/b&gt;&lt;br&gt;TABLE_NAME внутри файла&lt;br&gt;поля, типы и ограничения, PK, FK&lt;br&gt;исходник структуры одной таблицы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1880" y="1450" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="types_file" value="&lt;b&gt;types.def&lt;/b&gt;&lt;br&gt;общие именованные типы&lt;br&gt;ограничения колонки переопределяют тип" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2170" y="1450" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rules_file" value="&lt;b&gt;table_0001.rules.rs&lt;/b&gt;&lt;br&gt;Доверенные Rust-функции:&lt;br&gt;проверки и формулы&lt;br&gt;Не пользовательские строки-формулы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1450" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="module_file" value="&lt;b&gt;db/modules/table_0001_v1 — скомпилированный модуль&lt;/b&gt;&lt;br&gt;Старые версии сохраняются до удаления старых сегментов" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=15;fontFamily=Arial;fontColor=#243247;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2100" y="1630" width="620" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
