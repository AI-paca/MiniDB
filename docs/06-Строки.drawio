<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="t6" name="06-Строки">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
<root>
<mxCell id="0" /><mxCell id="1" parent="0" />

<mxCell id="t" value="Что меняется в таблице при вставке, удалении и изменении строки" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell>

<mxCell id="i" value="Вставка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="440" as="geometry" /></mxCell>
<mxCell id="i1" value="1. проверить типы и ограничения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="i"><mxGeometry x="20" y="45" width="380" height="35" as="geometry" /></mxCell>
<mxCell id="i2" value="2. ключ не задан → выдать следующий номер&lt;br&gt;ключ занят → отказ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="i"><mxGeometry x="20" y="90" width="380" height="45" as="geometry" /></mxCell>
<mxCell id="i3" value="3. проверить ссылки через указатели родителей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="i"><mxGeometry x="20" y="145" width="380" height="35" as="geometry" /></mxCell>
<mxCell id="i4" value="4. взять слот: сначала из списка свободных,&lt;br&gt;иначе удлинить файл последней версии" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="i"><mxGeometry x="20" y="190" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="i5" value="5. если в слоте лежала удалённая строка с самым большим ключом — сохранить счётчик номеров в схему" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="i"><mxGeometry x="20" y="250" width="380" height="60" as="geometry" /></mxCell>
<mxCell id="i6" value="6. пометить слот свободным&lt;br&gt;7. записать тело&lt;br&gt;8. поставить флаг «живой»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="i"><mxGeometry x="20" y="320" width="380" height="60" as="geometry" /></mxCell>
<mxCell id="i7" value="9. добавить ключ в указатель" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="i"><mxGeometry x="20" y="390" width="380" height="35" as="geometry" /></mxCell>

<mxCell id="d" value="Удаление" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="420" height="440" as="geometry" /></mxCell>
<mxCell id="d1" value="1. собрать ключи строк, попавших под условие" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="d"><mxGeometry x="20" y="45" width="380" height="35" as="geometry" /></mxCell>
<mxCell id="d2" value="2. просмотреть каждую дочернюю таблицу целиком:&lt;br&gt;есть ссылка → отказ, не удаляется ничего" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="d"><mxGeometry x="20" y="90" width="380" height="55" as="geometry" /></mxCell>
<mxCell id="d3" value="3. заменить один флаг на «удалён»&lt;br&gt;тело строки остаётся в файле" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="d"><mxGeometry x="20" y="155" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="d4" value="4. убрать ключ из указателя&lt;br&gt;5. слот — в список свободных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="d"><mxGeometry x="20" y="215" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="d5" value="соседние слоты не двигаются&lt;br&gt;адреса в указателе остаются верными&lt;br&gt;файл не уменьшается" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="d"><mxGeometry x="20" y="280" width="380" height="65" as="geometry" /></mxCell>
<mxCell id="d6" value="ключ удалённой строки остаётся учтённым&lt;br&gt;в счётчике номеров: он не будет выдан заново" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="d"><mxGeometry x="20" y="355" width="380" height="55" as="geometry" /></mxCell>

<mxCell id="u" value="Изменение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="420" height="440" as="geometry" /></mxCell>
<mxCell id="u1" value="1. пройти строки по условию&lt;br&gt;и собрать все новые варианты заранее" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="u"><mxGeometry x="20" y="45" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="u2" value="2. строка, у которой ничего не поменялось,&lt;br&gt;в пакет не попадает и не переписывается" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="u"><mxGeometry x="20" y="105" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="u3" value="3. проверить весь пакет: типы, ссылки,&lt;br&gt;занятость новых ключей, ссылки на старые" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="u"><mxGeometry x="20" y="165" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="u4" value="4а. строка в последней версии&lt;br&gt;→ перезаписать на месте, адрес прежний" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="u"><mxGeometry x="20" y="225" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="u5" value="4б. строка в старой версии&lt;br&gt;→ записать в последнюю,&lt;br&gt;старый слот пометить удалённым,&lt;br&gt;адрес в указателе сменить" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="u"><mxGeometry x="20" y="285" width="380" height="80" as="geometry" /></mxCell>
<mxCell id="u6" value="проверка идёт по итоговому набору ключей:&lt;br&gt;поменять ключи двух строк местами можно" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="u"><mxGeometry x="20" y="375" width="380" height="50" as="geometry" /></mxCell>

<mxCell id="w" value="Почему порядок записи именно такой&lt;br&gt;&lt;br&gt;Обрыв до последнего шага оставит слот помеченным свободным, недописанная строка не станет видимой.&lt;br&gt;Это снижает риск, но не делает операцию обратимой: журнала и отката нет, и при обрыве посреди пакета часть строк уже изменена.&lt;br&gt;После любой ошибки записи таблица помечается испорченной и до перестройки указателя больше ничего не выполняет." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1320" height="140" as="geometry" /></mxCell>

</root>
</mxGraphModel>
</diagram>

</mxfile>