<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="g3" name="03-Изменение">
<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
<root>
<mxCell id="0" /><mxCell id="1" parent="0" />

<mxCell id="t" value="Изменение строки и переезд между версиями" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry" /></mxCell>

<mxCell id="p1" value="собрать новые варианты строк&lt;br&gt;и проверить весь пакет до записи" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="330" height="70" as="geometry" /></mxCell>
<mxCell id="p2" value="строка не изменилась?&lt;br&gt;не трогаем её вовсе" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="80" width="330" height="70" as="geometry" /></mxCell>
<mxCell id="p3" value="где лежит строка?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="300" height="90" as="geometry" /></mxCell>

<mxCell id="L" value="в последней версии" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;startSize=34;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="500" height="180" as="geometry" /></mxCell>
<mxCell id="L1" value="перезаписать слот на месте&lt;br&gt;&lt;br&gt;адрес прежний, указатель не трогаем&lt;br&gt;если сменился ключ — поправить только его" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="L"><mxGeometry x="20" y="50" width="460" height="110" as="geometry" /></mxCell>

<mxCell id="O" value="в старой версии" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;startSize=34;rounded=1;" vertex="1" parent="1"><mxGeometry x="580" y="220" width="500" height="180" as="geometry" /></mxCell>
<mxCell id="O1" value="записать строку в последнюю версию&lt;br&gt;старый слот пометить удалённым&lt;br&gt;указатель перевести на новый адрес&lt;br&gt;&lt;br&gt;&lt;i&gt;в старой версии недостающих колонок просто нет&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="O"><mxGeometry x="20" y="50" width="460" height="110" as="geometry" /></mxCell>

<mxCell id="R" value="Что из этого следует" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;startSize=34;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1040" height="180" as="geometry" /></mxCell>
<mxCell id="R1" value="строки сами перетекают в последнюю версию&lt;br&gt;по мере того, как их изменяют" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="R"><mxGeometry x="20" y="50" width="330" height="110" as="geometry" /></mxCell>
<mxCell id="R2" value="отдельной процедуры переноса нет:&lt;br&gt;нетронутая строка может остаться&lt;br&gt;в первой версии навсегда" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="R"><mxGeometry x="365" y="50" width="330" height="110" as="geometry" /></mxCell>
<mxCell id="R3" value="пакет проверяется по итоговому набору ключей,&lt;br&gt;поэтому ключи двух строк можно поменять местами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="R"><mxGeometry x="710" y="50" width="310" height="110" as="geometry" /></mxCell>

<mxCell id="n" value="Записи идут по одной. Обрыв посреди пакета оставит часть строк уже изменённой: журнала и отката нет." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1040" height="55" as="geometry" /></mxCell>

<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="L"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6366f1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="O"><mxGeometry relative="1" as="geometry" /></mxCell>

</root>
</mxGraphModel>
</diagram>

</mxfile>