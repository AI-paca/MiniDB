<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="t7" name="07-Колонки">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0" /><mxCell id="1" parent="0" />

<mxCell id="t" value="Добавление колонки и смена версии" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry" /></mxCell>

<mxCell id="b" value="Было" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="400" height="190" as="geometry" /></mxCell>
<mxCell id="b1" value="схема: id · name · task · size&lt;br&gt;версия 1 — единственная&lt;br&gt;все строки в ней" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="b"><mxGeometry x="20" y="45" width="360" height="70" as="geometry" /></mxCell>

<mxCell id="c" value="Команда" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="400" height="190" as="geometry" /></mxCell>
<mxCell id="c1" value="добавить колонку note, допускающую пустое&lt;br&gt;&lt;br&gt;пустое обязательно: старым строкам&lt;br&gt;нечего подставить, а переписывать их&lt;br&gt;мы не хотим" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="c"><mxGeometry x="20" y="45" width="360" height="110" as="geometry" /></mxCell>

<mxCell id="st" value="Шаги" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="420" height="330" as="geometry" /></mxCell>
<mxCell id="st1" value="1. собрать новую схему и проверить совместимость" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="st"><mxGeometry x="20" y="45" width="380" height="40" as="geometry" /></mxCell>
<mxCell id="st2" value="2. посчитать дескриптор новой версии" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="st"><mxGeometry x="20" y="95" width="380" height="35" as="geometry" /></mxCell>
<mxCell id="st3" value="3. создать пустой файл новой версии" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="st"><mxGeometry x="20" y="140" width="380" height="35" as="geometry" /></mxCell>
<mxCell id="st4" value="4. переписать файл схемы:&lt;br&gt;номер версии и новая запись в истории колонок" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="st"><mxGeometry x="20" y="185" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="st5" value="5. прежний файл версии перевести в режим чтения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="st"><mxGeometry x="20" y="245" width="380" height="40" as="geometry" /></mxCell>

<mxCell id="a" value="Стало" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="850" height="280" as="geometry" /></mxCell>
<mxCell id="a1" value="&lt;b&gt;версия 1&lt;/b&gt;: id · name · task · size&lt;br&gt;&lt;br&gt;файл не открывался на запись&lt;br&gt;ни один байт не переписан&lt;br&gt;колонка note у этих строк читается как пусто" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="a"><mxGeometry x="20" y="45" width="390" height="120" as="geometry" /></mxCell>
<mxCell id="a2" value="&lt;b&gt;версия 2&lt;/b&gt;: id · name · task · size · note&lt;br&gt;&lt;br&gt;пустая, своя ширина слота&lt;br&gt;сюда идут все новые строки&lt;br&gt;и строки версии 1 при изменении" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="a"><mxGeometry x="430" y="45" width="390" height="120" as="geometry" /></mxCell>
<mxCell id="a3" value="указатель теперь хранит ещё и номер версии&lt;br&gt;выборка идёт по всем версиям подряд&lt;br&gt;строки постепенно перетекают в последнюю версию сами, без отдельной процедуры" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="a"><mxGeometry x="20" y="180" width="800" height="70" as="geometry" /></mxCell>

<mxCell id="n" value="Чего нельзя и почему" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="940" y="440" width="420" height="330" as="geometry" /></mxCell>
<mxCell id="n1" value="&lt;b&gt;удалить колонку&lt;/b&gt;&lt;br&gt;смещения всех следующих колонок сдвинулись бы,&lt;br&gt;пришлось бы переписать все файлы версий&lt;br&gt;— именно того, чего мы избегаем" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="n"><mxGeometry x="20" y="45" width="380" height="90" as="geometry" /></mxCell>
<mxCell id="n2" value="&lt;b&gt;вставить колонку в середину&lt;/b&gt;&lt;br&gt;то же самое&lt;br&gt;&lt;br&gt;&lt;b&gt;сменить тип или ширину&lt;/b&gt;&lt;br&gt;старые слоты стали бы нечитаемыми&lt;br&gt;&lt;br&gt;&lt;b&gt;сменить колонку-ключ&lt;/b&gt;&lt;br&gt;указатель и все ссылки пришлось бы пересобирать" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="n"><mxGeometry x="20" y="145" width="380" height="160" as="geometry" /></mxCell>

<mxCell id="w" value="Цена добавления колонки — одна перезапись файла схемы и один пустой файл. Данные не читаются и не переписываются совсем.&lt;br&gt;Побочный эффект: добавление колонки на пустой таблице тоже создаёт новый файл, поэтому после нескольких добавлений подряд в каталоге лежат пустые файлы прежних версий." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="850" height="90" as="geometry" /></mxCell>

<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="c" target="st"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6366f1;" edge="1" parent="1" source="st" target="a"><mxGeometry relative="1" as="geometry" /></mxCell>

</root>
</mxGraphModel>
</diagram>

</mxfile>