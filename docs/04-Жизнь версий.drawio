<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="g4" name="04-Жизнь версий">
<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0">
<root>
<mxCell id="0" /><mxCell id="1" parent="0" />

<mxCell id="t" value="Что будет, когда версий станет много" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry" /></mxCell>

<mxCell id="S" value="Как версия пустеет" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;startSize=34;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1040" height="220" as="geometry" /></mxCell>
<mxCell id="S1" value="версия 1&lt;br&gt;&lt;br&gt;20 живых строк" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="S"><mxGeometry x="30" y="60" width="200" height="110" as="geometry" /></mxCell>
<mxCell id="S2" value="строки изменяют&lt;br&gt;или удаляют&lt;br&gt;&lt;br&gt;изменённые уезжают&lt;br&gt;в последнюю версию" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=11;" vertex="1" parent="S"><mxGeometry x="280" y="60" width="200" height="110" as="geometry" /></mxCell>
<mxCell id="S3" value="версия 1&lt;br&gt;&lt;br&gt;0 живых,&lt;br&gt;20 удалённых слотов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="S"><mxGeometry x="530" y="60" width="200" height="110" as="geometry" /></mxCell>
<mxCell id="S4" value="файл остаётся&lt;br&gt;прежнего размера&lt;br&gt;&lt;br&gt;и читается при каждом&lt;br&gt;полном просмотре" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;" vertex="1" parent="S"><mxGeometry x="780" y="60" width="220" height="110" as="geometry" /></mxCell>

<mxCell id="X" value="Почему пустая версия не исчезает сама" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#f87171;startSize=34;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="510" height="280" as="geometry" /></mxCell>
<mxCell id="X1" value="освободившиеся слоты старой версии&lt;br&gt;под новые строки не используются:&lt;br&gt;вставка идёт только в последнюю" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="X"><mxGeometry x="20" y="50" width="470" height="65" as="geometry" /></mxCell>
<mxCell id="X2" value="история версий в схеме сплошная:&lt;br&gt;нельзя вычеркнуть версию 1 и оставить 2 и 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="X"><mxGeometry x="20" y="125" width="470" height="55" as="geometry" /></mxCell>
<mxCell id="X3" value="удалить файл руками нельзя:&lt;br&gt;при открытии база потребует файл каждой версии из истории" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="X"><mxGeometry x="20" y="190" width="470" height="60" as="geometry" /></mxCell>

<mxCell id="Y" value="Во что это обходится" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;startSize=34;rounded=1;" vertex="1" parent="1"><mxGeometry x="570" y="330" width="510" height="280" as="geometry" /></mxCell>
<mxCell id="Y1" value="место на диске не освобождается никогда" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="Y"><mxGeometry x="20" y="50" width="470" height="45" as="geometry" /></mxCell>
<mxCell id="Y2" value="полный просмотр продолжает читать все старые слоты,&lt;br&gt;даже когда живых строк в них не осталось" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="Y"><mxGeometry x="20" y="105" width="470" height="55" as="geometry" /></mxCell>
<mxCell id="Y3" value="открытие базы тоже читает их заново" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="Y"><mxGeometry x="20" y="170" width="470" height="45" as="geometry" /></mxCell>
<mxCell id="Y4" value="поиск по ключу и проверка ссылок не страдают:&lt;br&gt;они идут по указателю, а не по файлам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=11;" vertex="1" parent="Y"><mxGeometry x="20" y="225" width="470" height="45" as="geometry" /></mxCell>

<mxCell id="Z" value="Что понадобилось бы для уборки старых версий&lt;br&gt;&lt;br&gt;перенести оставшиеся живые строки в последнюю версию · удалить файл · вычеркнуть версию из истории и перенумеровать остальные&lt;br&gt;ничего из этого сейчас нет, отдельной команды уборки тоже нет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1040" height="120" as="geometry" /></mxCell>

<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="S" source="S1" target="S2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="S" source="S2" target="S3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#fb923c;" edge="1" parent="S" source="S3" target="S4"><mxGeometry relative="1" as="geometry" /></mxCell>

</root>
</mxGraphModel>
</diagram>

</mxfile>