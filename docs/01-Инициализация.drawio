<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="t1" name="01-Инициализация">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0" /><mxCell id="1" parent="0" />

<mxCell id="t" value="Что происходит при открытии базы" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry" /></mxCell>

<mxCell id="s1" value="1. Каталог базы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="380" height="210" as="geometry" /></mxCell>
<mxCell id="s1a" value="занять замок&lt;br&gt;&lt;i&gt;одна база — один процесс&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="s1"><mxGeometry x="20" y="45" width="340" height="45" as="geometry" /></mxCell>
<mxCell id="s1b" value="найти файлы схем&lt;br&gt;&lt;i&gt;список таблиц = список этих файлов,&lt;br&gt;отдельного файла-каталога нет&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="s1"><mxGeometry x="20" y="100" width="340" height="55" as="geometry" /></mxCell>
<mxCell id="s1c" value="имя внутри схемы обязано совпадать&lt;br&gt;с именем файла, иначе отказ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="s1"><mxGeometry x="20" y="160" width="340" height="40" as="geometry" /></mxCell>

<mxCell id="s2" value="2. Для каждой таблицы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="470" y="70" width="440" height="470" as="geometry" /></mxCell>
<mxCell id="s2a" value="прочитать текст схемы:&lt;br&gt;колонки и типы · ключ · ссылки&lt;br&gt;номер версии&lt;br&gt;сколько колонок было в каждой версии&lt;br&gt;счётчик выданных номеров" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="s2"><mxGeometry x="20" y="45" width="400" height="80" as="geometry" /></mxCell>
<mxCell id="s2b" value="построить дескриптор на каждую версию&lt;br&gt;&lt;i&gt;версия N = первые K колонок текущей схемы,&lt;br&gt;K берётся из истории в файле схемы&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="s2"><mxGeometry x="20" y="135" width="400" height="60" as="geometry" /></mxCell>
<mxCell id="s2c" value="открыть файлы версий&lt;br&gt;&lt;i&gt;последняя — на чтение и запись&lt;br&gt;прежние — только на чтение&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="s2"><mxGeometry x="20" y="205" width="400" height="55" as="geometry" /></mxCell>
<mxCell id="s2d" value="лишний файл версии, которого нет в истории → отказ&lt;br&gt;&lt;i&gt;иначе данные молча потерялись бы из выдачи&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="s2"><mxGeometry x="20" y="270" width="400" height="45" as="geometry" /></mxCell>
<mxCell id="s2e" value="полный проход по всем слотам всех версий:&lt;br&gt;&lt;br&gt;живой  → ключ в указатель, обновить максимум&lt;br&gt;удалён → ключ учесть в максимуме, слот в свободные&lt;br&gt;свободен → слот в свободные&lt;br&gt;два одинаковых ключа → отказ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="s2"><mxGeometry x="20" y="325" width="400" height="120" as="geometry" /></mxCell>

<mxCell id="s3" value="3. Когда все таблицы открыты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="400" height="210" as="geometry" /></mxCell>
<mxCell id="s3a" value="проверить ссылки между таблицами&lt;br&gt;&lt;i&gt;таблица-родитель существует&lt;br&gt;цель ссылки — именно её ключ&lt;br&gt;колонка-ссылка целочисленная&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="s3"><mxGeometry x="20" y="45" width="360" height="75" as="geometry" /></mxCell>
<mxCell id="s3b" value="порядок открытия не важен:&lt;br&gt;ссылки проверяются после загрузки всех схем" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="s3"><mxGeometry x="20" y="130" width="360" height="50" as="geometry" /></mxCell>

<mxCell id="res" value="Что лежит в памяти после открытия" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="960" y="310" width="400" height="230" as="geometry" /></mxCell>
<mxCell id="res1" value="схема таблицы&lt;br&gt;дескриптор на каждую версию&lt;br&gt;указатель: ключ → версия + адрес&lt;br&gt;список свободных слотов&lt;br&gt;максимальный выданный ключ&lt;br&gt;один рабочий буфер на таблицу" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="res"><mxGeometry x="20" y="45" width="360" height="110" as="geometry" /></mxCell>
<mxCell id="res2" value="на диск указатель не пишется:&lt;br&gt;он производный и восстановим из данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="res"><mxGeometry x="20" y="165" width="360" height="45" as="geometry" /></mxCell>

<mxCell id="cost" value="Цена открытия = весь объём данных. Это единственная операция, которая всегда читает всё.&lt;br&gt;Зато нет файла индекса, который мог бы разойтись с данными, и нет процедуры его починки." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1320" height="60" as="geometry" /></mxCell>

<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="s3" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>

</root>
</mxGraphModel>
</diagram>

</mxfile>