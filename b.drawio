<mxfile host="app.diagrams.net" type="device">
  <diagram id="minidb-real" name="MiniDB — реальная архитектура">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="bg_cli" value="ВВОД КОМАНД" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=17;fontColor=#334155;fontFamily=Arial;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="40" y="120" width="420" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="bg_engine" value="ДВИЖОК — ОДИН ПРОЦЕСС" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f0f7f3;strokeColor=#9ac2aa;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=17;fontColor=#315b43;fontFamily=Arial;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="500" y="120" width="1180" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="bg_format" value="ФОРМАТ ЗАПИСИ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f6f2fa;strokeColor=#b9a3cf;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=17;fontColor=#5b4374;fontFamily=Arial;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1720" y="120" width="620" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="bg_files" value="ФАЙЛЫ БАЗЫ — ПЛОСКИЙ КАТАЛОГ, ВСЁ ТЕКСТОМ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdf1f0;strokeColor=#d8a3a0;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=17;fontColor=#874a47;fontFamily=Arial;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="40" y="860" width="2300" height="470" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;Пользователь&lt;/b&gt;&lt;br&gt;интерактивно или ./minidb &amp;lt; script" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="190" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="terminal" value="&lt;b&gt;terminal.rs + completion.rs&lt;/b&gt; (Unix)&lt;br&gt;сырой режим через stty, история в .history&lt;br&gt;Tab — дополнение по таблицам и колонкам" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="sql" value="&lt;b&gt;sql.rs&lt;/b&gt; — свой разбор SQL&lt;br&gt;токенизатор: слова, строки в кавычках, --комментарии&lt;br&gt;рекурсивный спуск: NOT → AND → OR, скобки&lt;br&gt;Command: CREATE / ALTER / INSERT / SELECT&lt;br&gt;UPDATE / DELETE / BACKUP / RESTORE / DESCRIBE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="360" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="mainrs" value="&lt;b&gt;main.rs&lt;/b&gt; — исполнение команд&lt;br&gt;Literal → Value по типу колонки&lt;br&gt;печать таблицей, обрезка длинных значений&lt;br&gt;ON a = b разрешается в обе стороны" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="665" width="360" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="database" value="&lt;b&gt;database.rs — Database&lt;/b&gt;&lt;br&gt;каталог: имя → Table, открывается по *.schema.sql&lt;br&gt;PK: уникальность и авто-ID&lt;br&gt;FK: колонка → PRIMARY KEY целевой таблицы&lt;br&gt;DELETE — RESTRICT: скан дочерних таблиц&lt;br&gt;блокировка каталога через .lock" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="190" width="430" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="query" value="&lt;b&gt;query.rs&lt;/b&gt;&lt;br&gt;Expr → Filter: имя колонки → номер ОДИН раз&lt;br&gt;= != &amp;gt; &amp;lt; &amp;gt;= &amp;lt;=, AND / OR / NOT, IS NULL&lt;br&gt;трёхзначная логика: NULL даёт UNKNOWN&lt;br&gt;строки отдаются по одной, без временной таблицы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1010" y="190" width="430" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="update" value="&lt;b&gt;database/update.rs&lt;/b&gt;&lt;br&gt;весь UPDATE готовится и проверяется до записи&lt;br&gt;строка без изменений не переписывается&lt;br&gt;перестановка PK (1↔2) разрешена в пакете" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="425" width="430" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="backup" value="&lt;b&gt;database/backup.rs&lt;/b&gt;&lt;br&gt;BACKUP: копия схем и сегментов в новый каталог&lt;br&gt;RESTORE: копия → проверка открытием → rename&lt;br&gt;прежняя база сохраняется до успеха" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1010" y="425" width="430" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="table" value="&lt;b&gt;table.rs — Table&lt;/b&gt;&lt;br&gt;index: PK → (версия сегмента, смещение), в памяти&lt;br&gt;при открытии индекс строится полным проходом&lt;br&gt;buf — один рабочий буфер на таблицу&lt;br&gt;free — список свободных слотов&lt;br&gt;после ошибки записи таблица требует rebuild_index" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="610" width="430" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="segment" value="&lt;b&gt;Segment — файл одной версии схемы&lt;/b&gt;&lt;br&gt;внутри сегмента все записи одной длины&lt;br&gt;адрес записи = номер слота × длина записи&lt;br&gt;INSERT и UPDATE пишут только в последний&lt;br&gt;старые сегменты открыты на чтение&lt;br&gt;строка из старого при UPDATE переносится в новый" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1010" y="610" width="430" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="schema_mod" value="&lt;b&gt;schema.rs + types.rs&lt;/b&gt;&lt;br&gt;INT, FLOAT, STRING(n) + MIN / MAX / NULL&lt;br&gt;PRIMARY KEY: INT NOT NULL&lt;br&gt;эволюция: только новая NULL-колонка в конец&lt;br&gt;&lt;b&gt;storage.rs&lt;/b&gt; — имена файлов и текст схемы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1490" y="190" width="170" height="610" as="geometry"/>
        </mxCell>

        <mxCell id="layout" value="&lt;b&gt;layout.rs — Layout&lt;/b&gt;&lt;br&gt;из схемы один раз считает ширину и смещение&lt;br&gt;каждого поля и длину всей записи&lt;br&gt;пересчитывается только при ALTER&lt;br&gt;у старого сегмента — Layout по первым N колонкам" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1750" y="190" width="560" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="record" value="&lt;b&gt;record.rs — Row&lt;/b&gt;&lt;br&gt;чтение поля: сразу по готовому смещению,&lt;br&gt;без разбора предыдущих полей&lt;br&gt;ограничения схемы проверяются при записи,&lt;br&gt;а не при каждом чтении&lt;br&gt;поля, которых нет в старом сегменте, читаются как NULL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1750" y="395" width="560" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="slot" value="&lt;b&gt;Один слот — одна строка файла, фиксированной ширины&lt;/b&gt;&lt;br&gt;&lt;br&gt;[флаг][поле 1][поле 2]…[перевод строки]&lt;br&gt;&lt;br&gt;флаг: + живая, - удалённая, . свободная&lt;br&gt;DELETE меняет один символ, остальные записи не двигаются&lt;br&gt;INSERT: сначала тело как свободное, затем флаг + " style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1750" y="620" width="560" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="f_schema" value="&lt;b&gt;datasets_schema&lt;/b&gt; — текст, читается в IDE&lt;br&gt;CREATE TABLE в обычном SQL&lt;br&gt;VERSION и число колонок каждой версии&lt;br&gt;счётчик авто-ID последней строкой" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="940" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="f_data" value="&lt;b&gt;datasets_v1&lt;/b&gt;, &lt;b&gt;datasets_v2&lt;/b&gt; — данные&lt;br&gt;строка файла = слот, слоты одной ширины&lt;br&gt;v2 появляется после ALTER TABLE ADD COLUMN&lt;br&gt;старый файл при этом не переписывается" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="940" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="f_lock" value="&lt;b&gt;.lock&lt;/b&gt; — одна база открыта одним процессом&lt;br&gt;&lt;br&gt;&lt;b&gt;.history&lt;/b&gt; — история команд консоли" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="940" width="440" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="f_backup" value="&lt;b&gt;db_backups/&amp;lt;имя&amp;gt;/&lt;/b&gt;&lt;br&gt;копия схем и всех сегментов&lt;br&gt;восстановление проверяет копию до замены базы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1580" y="940" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="f_gen" value="&lt;b&gt;codegen.rs&lt;/b&gt; — отдельная команда, не часть работы базы&lt;br&gt;по схеме выдаёт готовый Rust-файл со структурой таблицы&lt;br&gt;нужен другой программе, которая хочет работать с базой типизированно&lt;br&gt;обратно в движок ничего не загружается, компилятор при работе базы не запускается" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.6;fontSize=14;fontFamily=Arial;fontColor=#243247;spacing=10;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="1130" width="1970" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="Что гарантируется: данные переживают перезапуск; PK уникален; нельзя сослаться на несуществующую строку и нельзя удалить строку, на которую ссылаются; поиск по ключу идёт через индекс, иначе полным проходом.&#10;Что не гарантируется: это не транзакции — при сбое питания посреди пакетной операции часть строк может остаться изменённой. Журнала и отката нет." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacing=16;fontSize=14;fontColor=#475569;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="1370" width="2300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="a1" value="команда" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b6585;fontColor=#4b6585;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="terminal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="строка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b6585;fontColor=#4b6585;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="terminal" target="sql">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="разобранная команда" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b6585;fontColor=#4b6585;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sql" target="mainrs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="вызовы API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b6585;fontColor=#4b6585;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mainrs" target="database">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="704"/>
              <mxPoint x="480" y="285"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a5" value="условие" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b6585;fontColor=#4b6585;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="database" target="query">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#b4891f;fontColor=#b4891f;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="database" target="update">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a7" value="BACKUP / RESTORE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#b4891f;fontColor=#b4891f;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="query" target="backup">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a8" value="чтение и запись строк" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b6585;fontColor=#4b6585;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="update" target="table">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a9" value="копирование файлов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b6585;fontColor=#4b6585;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="backup" target="segment">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a10" value="слот по смещению" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b6585;fontColor=#4b6585;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="table" target="segment">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a11" value="смещения полей" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#80619a;fontColor=#80619a;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="segment" target="record">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1700" y="658"/>
              <mxPoint x="1700" y="490"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a12" value="строит" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#80619a;fontColor=#80619a;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="schema_mod" target="layout">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#80619a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="layout" target="record">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#80619a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="record" target="slot">
